<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ViewModels;assembly=ViewModels"
             x:Class="MyCapital.MAUI.Pages.Field"
             x:DataType="viewModels:Field_VM">

    <Frame CornerRadius="10"
           BackgroundColor="#303030">
        
        <VerticalStackLayout Spacing="10">

            <HorizontalStackLayout Spacing="30"
                           HorizontalOptions="Center">

                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Color="#ECECEC"
                          VerticalOptions="Center"
                          HorizontalOptions="End"
                          />

                <Entry Text="{Binding Title, Mode=TwoWay}"
                       Placeholder="Введите имя"
                       FontAutoScalingEnabled="False"
                       TextColor="White"
                       FontSize="20"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       />

                <Button Text="X"
                        WidthRequest="40"
                        FontAutoScalingEnabled="False"
                        FontSize="20"
                        TextColor="IndianRed"
                        Background="#404040"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        Command="{Binding Command_RemoveField}"
                        />

            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="20"
                           HorizontalOptions="Center">

                <Entry Text="{Binding AmountOfMoney, Mode=TwoWay}"
                       Keyboard="Numeric"
                       Placeholder="..."                   
                       WidthRequest="120"
                       BackgroundColor="#404040"
                       FontAutoScalingEnabled="False"
                       TextColor="#D0D0D0"
                       FontSize="20"
                       MaxLength="11"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" 
                       HorizontalOptions="End"
                       />

                <Button Text="{Binding SelectedCurrencyName, Mode=OneWay}"
                        FontAutoScalingEnabled="False"
                        FontSize="20"
                        TextColor="#569CD6"
                        Background="#404040"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        Command="{Binding Command_SelectTypeOfCurrency}"
                        />

            </HorizontalStackLayout>

        </VerticalStackLayout>
        
    </Frame>    
    
</ContentView>
